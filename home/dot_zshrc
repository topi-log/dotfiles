# ~/.zshrc — 対話シェルを開くたびに読まれる。
#
# エイリアス・プロンプト・補完・シェル関数を置く。これらは環境変数ではなく
# 子プロセスに継承されないため、対話シェルごとに設定し直す必要がある。
# PATH と環境変数は ~/.zprofile に置く。

# --- バージョン管理ツール -------------------------------------------------
# init は shims の PATH 追加とシェル関数の定義を行う。関数は継承されないため
# 対話シェルごとに評価する（nodenv / rbenv 公式の推奨も .zshrc）。
command -v nodenv >/dev/null 2>&1 && eval "$(nodenv init -)"
command -v rbenv  >/dev/null 2>&1 && eval "$(rbenv init -)"

# --- エイリアス -----------------------------------------------------------
# wezterm CLI
alias wta='(){wezterm cli spawn --new-window --workspace "$1"}'
alias wtl='wezterm cli list'
alias wtc='wezterm cli list-clients'

# GitHub Copilot CLI
[ -x /opt/homebrew/bin/copilot ] && alias copilot="/opt/homebrew/bin/copilot"

# --- 補完 -----------------------------------------------------------------
# ~/.zsh には git 公式の補完スクリプト（git-completion.bash, _git）を置く。
# GPL-2.0 のため本リポジトリでは配布しない。取得方法は README を参照。
if [ -d "$HOME/.zsh" ]; then
  fpath=("$HOME/.zsh" $fpath)
  [ -f "$HOME/.zsh/git-completion.bash" ] &&
    zstyle ':completion:*:*:git:*' script "$HOME/.zsh/git-completion.bash"
fi
autoload -Uz compinit && compinit

# --- プロンプト -----------------------------------------------------------
# カレントディレクトリ名と git ブランチを表示する。
# vcs_info は zsh 組み込みなので外部スクリプトを必要としない。
autoload -Uz add-zsh-hook vcs_info

zstyle ':vcs_info:git:*' formats ' (%F{green}%b%f)'
setopt prompt_subst

function update-vcs-info() {
  vcs_info
}
add-zsh-hook precmd update-vcs-info

PROMPT='%1~${vcs_info_msg_0_} %# '
