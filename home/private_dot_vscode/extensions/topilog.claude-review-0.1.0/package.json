{
  "name": "claude-review",
  "displayName": "Claude Review",
  "description": "Read-only local change review with line comments for Claude Code",
  "version": "0.1.0",
  "publisher": "topilog",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onUri"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "claudeReview.refresh", "title": "Refresh", "category": "Claude Review", "icon": "$(refresh)" },
      { "command": "claudeReview.addComment", "title": "Add Comment on Current Line", "category": "Claude Review", "icon": "$(comment-add)" },
      { "command": "claudeReview.deleteComment", "title": "Delete Review Comment", "category": "Claude Review", "icon": "$(trash)" },
      { "command": "claudeReview.clearComments", "title": "Clear All Comments", "category": "Claude Review" },
      { "command": "claudeReview.send", "title": "Send Comments to Claude Code", "category": "Claude Review", "icon": "$(send)" },
      { "command": "claudeReview.openFile", "title": "Open Diff", "category": "Claude Review" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "claudeReview", "title": "Claude Review", "icon": "media/review.svg" }
      ]
    },
    "views": {
      "claudeReview": [
        { "id": "claudeReview.files", "name": "Changed Files" },
        { "id": "claudeReview.comments", "name": "Review Comments" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "claudeReview.refresh", "when": "view == claudeReview.files", "group": "navigation@1" },
        { "command": "claudeReview.send", "when": "view == claudeReview.comments", "group": "navigation@1" },
        { "command": "claudeReview.clearComments", "when": "view == claudeReview.comments", "group": "navigation@2" }
      ],
      "editor/title": [
        { "command": "claudeReview.addComment", "when": "resourceScheme == claude-review-before || resourceScheme == claude-review-after", "group": "navigation@1" },
        { "command": "claudeReview.send", "when": "resourceScheme == claude-review-before || resourceScheme == claude-review-after", "group": "navigation@2" }
      ],
      "comments/commentThread/context": [
        { "command": "claudeReview.deleteComment", "when": "commentController == claudeReview", "group": "inline" }
      ]
    },
    "keybindings": [
      {
        "command": "claudeReview.addComment",
        "key": "cmd+alt+c",
        "when": "editorTextFocus && (resourceScheme == claude-review-before || resourceScheme == claude-review-after)"
      }
    ]
  }
}
