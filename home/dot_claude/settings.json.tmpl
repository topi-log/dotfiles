{
  "model": "claude-fable-5-1[1m]",
  "enabledPlugins": {{ .claudePlugins | toPrettyJson | indent 2 | trim }},
  "extraKnownMarketplaces": {{ .claudeMarketplaces | toPrettyJson | indent 2 | trim }},
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/session-status.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/session-status.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/session-status.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/session-status.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/session-status.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/notify-when-quiet.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/session-status.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/notify-when-quiet.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/notify-when-quiet.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/session-status.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "{{ .chezmoi.homeDir }}/workspace"
      ]
    }
  }
}
