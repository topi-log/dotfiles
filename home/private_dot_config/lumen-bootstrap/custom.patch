+++ b/src/command/diff/github_review.rs
@@ -0,0 +1,311 @@
+//! Read-only GitHub review context, with private local notes for Claude.
+use crossterm::event::{KeyCode, KeyEvent, KeyModifiers};
+use ratatui::{
+    prelude::*,
+    widgets::{Clear, Paragraph, Wrap},
+};
+use serde_json::Value;
+use std::{io, process::Command};
+use tui_textarea::TextArea;
+
+#[derive(Debug, Clone)]
+pub struct Item {
+    pub author: String,
+    pub body: String,
+    pub url: String,
+    pub location: String,
+    pub note: String,
+}
+pub struct Reviews {
+    pub items: Vec<Item>,
+    pub status: String,
+    pub open: bool,
+    index: usize,
+    scroll: u16,
+    editor: Option<TextArea<'static>>,
+}
+fn gh(args: &[&str]) -> io::Result<Value> {
+    let output = Command::new("gh").args(args).output()?;
+    if !output.status.success() {
+        return Err(io::Error::other(
+            String::from_utf8_lossy(&output.stderr).trim().to_string(),
+        ));
+    }
+    serde_json::from_slice(&output.stdout).map_err(io::Error::other)
+}
+fn field(v: &Value, key: &str) -> String {
+    v[key].as_str().unwrap_or("").to_string()
+}
+pub fn parse_pages(v: &Value, kind: &str) -> Vec<Item> {
+    v.as_array()
+        .into_iter()
+        .flatten()
+        .flat_map(|p| p.as_array().into_iter().flatten())
+        .filter_map(|v| {
+            let body = field(v, "body");
+            let state = field(v, "state");
+            if body.trim().is_empty() && kind != "レビュー結果" {
+                return None;
+            }
+            let author = v["user"]["login"]
+                .as_str()
+                .unwrap_or("deleted user")
+                .to_string();
+            let path = field(v, "path");
+            let location = if path.is_empty() {
+                format!("{} {}", kind, state)
+            } else {
+                let line = v["line"].as_u64();
+                format!(
+                    "{}:{} ({}){}",
+                    path,
+                    line.or(v["original_line"].as_u64())
+                        .map(|n| n.to_string())
+                        .unwrap_or("?".into()),
+                    field(v, "side"),
+                    if line.is_none() {
+                        " [古い差分のコメント]"
+                    } else {
+                        ""
+                    }
+                )
+            };
+            Some(Item {
+                author,
+                body,
+                url: field(v, "html_url"),
+                location,
+                note: String::new(),
+            })
+        })
+        .collect()
+}
+impl Reviews {
+    pub fn empty() -> Self {
+        Self {
+            items: vec![],
+            status: "GitHubレビュー未取得（diff --github-reviews で有効化）".into(),
+            open: false,
+            index: 0,
+            scroll: 0,
+            editor: None,
+        }
+    }
+    pub fn load(pr: Option<&super::PrInfo>) -> Self {
+        let mut r = Self::empty();
+        let result = (|| -> io::Result<()> {
+            let (repo, number) = if let Some(pr) = pr {
+                (format!("{}/{}", pr.repo_owner, pr.repo_name), pr.number)
+            } else {
+                let v = gh(&["pr", "view", "--json", "number,url"])?;
+                let url = field(&v, "url");
+                let parts: Vec<_> = url.split('/').collect();
+                if parts.len() < 7 || parts[2] != "github.com" {
+                    return Err(io::Error::other("github.com のPRを特定できません"));
+                }
+                (
+                    format!("{}/{}", parts[3], parts[4]),
+                    v["number"]
+                        .as_u64()
+                        .ok_or_else(|| io::Error::other("PR番号がありません"))?,
+                )
+            };
+            r.status = format!(
+                "{} #{} · 読み取り専用（GitHubには投稿しません）",
+                repo, number
+            );
+            let endpoints = [
+                (
+                    format!("repos/{repo}/pulls/{number}/comments?per_page=100"),
+                    "行コメント",
+                ),
+                (
+                    format!("repos/{repo}/pulls/{number}/reviews?per_page=100"),
+                    "レビュー結果",
+                ),
+                (
+                    format!("repos/{repo}/issues/{number}/comments?per_page=100"),
+                    "PRコメント",
+                ),
+            ];
+            let mut errors = vec![];
+            for (path, kind) in endpoints {
+                match gh(&["api", "--method", "GET", "--paginate", "--slurp", &path]) {
+                    Ok(v) => r.items.extend(parse_pages(&v, kind)),
+                    Err(e) => errors.push(format!("{kind}: {e}")),
+                }
+            }
+            if !errors.is_empty() {
+                r.status
+                    .push_str(&format!("\n一部取得失敗: {}", errors.join(" / ")));
+            }
+            Ok(())
+        })();
+        if let Err(e) = result {
+            r.status = format!("GitHubレビューを取得できません: {e}\nPRのないブランチではローカル差分のみ表示します。gh auth status も確認してください。");
+        }
+        r
+    }
+    pub fn note_count(&self) -> usize {
+        self.items
+            .iter()
+            .filter(|i| !i.note.trim().is_empty())
+            .count()
+    }
+    pub fn export(&self) -> String {
+        let mut out = String::new();
+        for item in &self.items {
+            if !item.note.trim().is_empty() {
+                out.push_str(&format!("\n\n## GitHubレビューに対する私のコメント\n\n参照: {}\n投稿者: {}\n場所: {}\n\n元のレビュー（引用）:\n",item.url,item.author,item.location));
+                for line in item.body.lines() {
+                    out.push_str(&format!("> {line}\n"));
+                }
+                out.push_str(&format!("\n私のコメント:\n{}\n", item.note));
+            }
+        }
+        out
+    }
+    // Returns true to send the complete local review after leaving this panel.
+    pub fn key(&mut self, key: KeyEvent) -> bool {
+        if let Some(editor) = self.editor.as_mut() {
+            match key.code {
+                KeyCode::Esc => {
+                    self.editor = None;
+                }
+                KeyCode::Enter
+                    if !key.modifiers.intersects(
+                        KeyModifiers::SHIFT | KeyModifiers::ALT | KeyModifiers::CONTROL,
+                    ) =>
+                {
+                    self.items[self.index].note = editor.lines().join("\n");
+                    self.editor = None;
+                }
+                KeyCode::Char('s') if key.modifiers.contains(KeyModifiers::CONTROL) => {
+                    self.items[self.index].note = editor.lines().join("\n");
+                    self.editor = None;
+                }
+                KeyCode::Char('j') if key.modifiers.contains(KeyModifiers::CONTROL) => {
+                    editor.insert_newline();
+                }
+                _ => {
+                    editor.input(key);
+                }
+            };
+            return false;
+        }
+        match key.code {
+            KeyCode::Esc | KeyCode::F(2) | KeyCode::Char('q') => self.open = false,
+            KeyCode::Char('j') | KeyCode::Down => self.scroll = self.scroll.saturating_add(1),
+            KeyCode::Char('k') | KeyCode::Up => self.scroll = self.scroll.saturating_sub(1),
+            KeyCode::Char('n') | KeyCode::Right => {
+                if !self.items.is_empty() {
+                    self.index = (self.index + 1) % self.items.len();
+                    self.scroll = 0;
+                }
+            }
+            KeyCode::Char('p') | KeyCode::Left => {
+                if !self.items.is_empty() {
+                    self.index = (self.index + self.items.len() - 1) % self.items.len();
+                    self.scroll = 0;
+                }
+            }
+            KeyCode::Char('c') => {
+                if let Some(i) = self.items.get(self.index) {
+                    self.editor = Some(TextArea::new(
+                        i.note.split('\n').map(str::to_owned).collect(),
+                    ));
+                }
+            }
+            KeyCode::Char('s') => {
+                self.open = false;
+                return true;
+            }
+            _ => {}
+        };
+        false
+    }
+    pub fn draw(&mut self, frame: &mut Frame) {
+        let area = frame.area();
+        let t = super::theme::get();
+        let style = Style::default().fg(t.ui.text_primary).bg(t.ui.bg);
+        frame.render_widget(Clear, area);
+        let chunks = Layout::vertical([
+            Constraint::Length(2),
+            Constraint::Min(1),
+            Constraint::Length(if self.editor.is_some() { 8 } else { 0 }),
+            Constraint::Length(2),
+        ])
+        .split(area);
+        frame.render_widget(
+            Paragraph::new(
+                "GitHubのレビュー · 元のレビューは読み取り専用\n".to_owned() + &self.status,
+            )
+            .style(style),
+            chunks[0],
+        );
+        let text = if let Some(i) = self.items.get(self.index) {
+            format!(
+                "{}/{} · @{}\n{}\n{}\n\n{}\n\n【私のコメント（Claude Codeにのみ送信）】\n{}",
+                self.index + 1,
+                self.items.len(),
+                i.author,
+                i.location,
+                i.url,
+                i.body,
+                i.note
+            )
+        } else {
+            format!("{}\n\n表示するレビューはありません。", self.status)
+        };
+        let lines = text
+            .lines()
+            .map(|l| {
+                Line::from(l)
+                    .width()
+                    .max(1)
+                    .div_ceil(chunks[1].width.max(1) as usize)
+            })
+            .sum::<usize>()
+            .min(u16::MAX as usize) as u16;
+        let p = Paragraph::new(text).wrap(Wrap { trim: false }).style(style);
+        // Count wrapped lines before clamping, so long comments stay navigable.
+
+        self.scroll = self.scroll.min(lines.saturating_sub(chunks[1].height));
+        frame.render_widget(p.scroll((self.scroll, 0)), chunks[1]);
+        if let Some(editor) = self.editor.as_mut() {
+            editor.set_block(
+                ratatui::widgets::Block::bordered()
+                    .title("私のコメント · Enter:保存 Ctrl+J:改行 Esc:取消"),
+            );
+            editor.set_style(style);
+            frame.render_widget(&*editor, chunks[2]);
+        }
+        frame.render_widget(Paragraph::new("n/p:次/前のレビュー j/k:本文スクロール c:自分のコメント\ns:Claude Codeへ送信 Esc/F2:差分に戻る（GitHubへ返信しません）").style(style),chunks[3]);
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn parses_pages_and_outdated_lines() {
+        let v = serde_json::json!([[{"user":{"login":"alice"},"body":"fix","html_url":"https://github.com/a/b/pull/1#discussion_r1","path":"a.rs","line":null,"original_line":4,"side":"LEFT"}],[]]);
+        let items = parse_pages(&v, "行");
+        assert_eq!(items.len(), 1);
+        assert!(items[0].location.contains("古い差分"));
+    }
+    #[test]
+    fn only_local_notes_are_exported() {
+        let mut r = Reviews::empty();
+        r.items = vec![Item {
+            author: "a".into(),
+            body: "external\ntext".into(),
+            url: "url".into(),
+            location: "a:2".into(),
+            note: String::new(),
+        }];
+        assert_eq!(r.export(), "");
+        r.items[0].note = "私の指示".into();
+        assert!(r.export().contains("> external\n> text"));
+        assert!(r.export().contains("私の指示"));
+    }
+}
