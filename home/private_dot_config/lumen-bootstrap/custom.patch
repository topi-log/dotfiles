diff --git a/src/review_session.rs b/src/review_session.rs
new file mode 100644
index 0000000..68c1df4
--- /dev/null
+++ b/src/review_session.rs
@@ -0,0 +1,198 @@
+//! Open a real terminal for a Claude tool call, returning only review text.
+#[cfg(unix)]
+use std::os::unix::fs::{DirBuilderExt, OpenOptionsExt};
+use std::{
+    fs, io,
+    path::{Path, PathBuf},
+    process::{Command, Stdio},
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+const WINDOW_CONFIG: &str = r#"local wezterm = require 'wezterm'
+wezterm.on('gui-startup', function(cmd)
+  local _, _, window = wezterm.mux.spawn_window(cmd or {})
+  window:gui_window():toggle_fullscreen()
+end)
+return {
+  enable_tab_bar = false,
+  check_for_updates = false,
+  exit_behavior = 'Close',
+  window_close_confirmation = 'NeverPrompt',
+  font_size = 14.0,
+  color_scheme = 'Builtin Dark',
+}
+"#;
+struct Session(PathBuf);
+impl Drop for Session {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+fn session() -> io::Result<Session> {
+    for n in 0..100 {
+        let path = std::env::temp_dir().join(format!(
+            "lumen-review-{}-{}-{n}",
+            std::process::id(),
+            SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_nanos()
+        ));
+        let mut builder = fs::DirBuilder::new();
+        #[cfg(unix)]
+        builder.mode(0o700);
+        match builder.create(&path) {
+            Ok(()) => return Ok(Session(path)),
+            Err(e) if e.kind() == io::ErrorKind::AlreadyExists => continue,
+            Err(e) => return Err(e),
+        }
+    }
+    Err(io::Error::other("レビュー用の一時ディレクトリを作れません"))
+}
+pub fn write_result(path: &Path, text: &str) -> io::Result<()> {
+    use io::Write;
+    let mut options = fs::OpenOptions::new();
+    options.create_new(true).write(true);
+    #[cfg(unix)]
+    options.mode(0o600);
+    let mut file = options.open(path)?;
+    file.write_all(text.as_bytes())?;
+    file.sync_all()
+}
+fn wezterm() -> PathBuf {
+    if let Some(path) = std::env::var_os("LUMEN_WEZTERM") {
+        return path.into();
+    }
+    let mac = PathBuf::from("/Applications/WezTerm.app/Contents/MacOS/wezterm");
+    if mac.is_file() {
+        mac
+    } else {
+        PathBuf::from("wezterm")
+    }
+}
+pub fn launch(repo: &Path, github: bool) -> io::Result<()> {
+    let root = Command::new("git")
+        .arg("-C")
+        .arg(repo)
+        .args(["rev-parse", "--show-toplevel"])
+        .output()?;
+    if !root.status.success() {
+        return Err(io::Error::other(
+            String::from_utf8_lossy(&root.stderr).to_string(),
+        ));
+    }
+    let root = PathBuf::from(String::from_utf8_lossy(&root.stdout).trim_end_matches('\n'));
+    let session = session()?;
+    let config = session.0.join("wezterm.lua");
+    fs::write(&config, WINDOW_CONFIG)?;
+    let mut cmd = Command::new(wezterm());
+    cmd.arg("--config-file")
+        .arg(&config)
+        .args([
+            "start",
+            "--always-new-process",
+            "--no-auto-connect",
+            "--cwd",
+        ])
+        .arg(&root)
+        .arg("--")
+        .arg(std::env::current_exe()?)
+        .arg("review-worker")
+        .arg("--directory")
+        .arg(&session.0)
+        .arg("--repo")
+        .arg(&root);
+    if github {
+        cmd.arg("--github-reviews");
+    }
+    eprintln!("レビュー専用ウィンドウを開きます。sで送信、qでキャンセル。元のClaude Codeで結果を待機します。");
+    let log = fs::File::create(session.0.join("window.log"))?;
+    let status = cmd
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(log)
+        .status()?;
+    let worker = fs::read_to_string(session.0.join("status"));
+    if !status.success() || worker.as_deref().is_ok_and(|s| s != "0") {
+        let error = fs::read_to_string(session.0.join("error.log")).unwrap_or_default();
+        let window = fs::read_to_string(session.0.join("window.log")).unwrap_or_default();
+        return Err(io::Error::other(launch_error(&error, &window)));
+    }
+    let output = session.0.join("review.md");
+    if output.exists() {
+        println!(
+            "# ユーザーが送信したコードレビュー\n\n{}",
+            fs::read_to_string(output)?
+        );
+    } else if worker.is_ok() {
+        println!("レビューは送信せず終了しました。修正を開始しないでください。");
+    } else {
+        return Err(io::Error::other(
+            "レビューが起動する前にウィンドウが閉じました",
+        ));
+    }
+    Ok(())
+}
+// WezTerm may dump the entire child environment, including credentials, on
+// spawn failure. Never propagate raw child logs into the agent conversation.
+fn launch_error(worker: &str, window: &str) -> &'static str {
+    if [worker, window].iter().any(|log| {
+        log.contains("Operation not permitted")
+            || log.contains("com.apple.hiservices-xpcservice")
+            || log.contains("Permission denied")
+    }) {
+        "レビューの起動権限が拒否されました。Claude CodeのBashから実行する場合は、この起動コマンドだけをdangerouslyDisableSandbox: trueで通常の承認フローに依頼してください。承認が拒否された場合は停止してください。認証情報保護のため詳細ログは省略しました。"
+    } else {
+        "レビューの起動・実行に失敗しました。WezTermの起動可否と対象リポジトリを確認してください。認証情報保護のため詳細ログは省略しました。"
+    }
+}
+
+pub fn worker(directory: &Path, repo: &Path, github: bool) -> io::Result<()> {
+    let error = fs::File::create(directory.join("error.log"))?;
+    let mut command = Command::new(std::env::current_exe()?);
+    command
+        .current_dir(repo)
+        .arg("diff")
+        .arg("--output")
+        .arg(directory.join("review.md"));
+    if github {
+        command.arg("--github-reviews");
+    }
+    let result = command.stderr(error).status();
+    let code = result.as_ref().ok().and_then(|s| s.code()).unwrap_or(1);
+    fs::write(directory.join("status"), code.to_string())?;
+    result.map(|_| ())
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn exclusive_result_and_private_directory() {
+        let s = session().unwrap();
+        let p = s.0.join("review.md");
+        write_result(&p, "日本語\nreview").unwrap();
+        assert!(write_result(&p, "overwrite").is_err());
+        assert_eq!(fs::read_to_string(p).unwrap(), "日本語\nreview");
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            assert_eq!(
+                fs::metadata(&s.0).unwrap().permissions().mode() & 0o777,
+                0o700
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+mod error_tests {
+    use super::launch_error;
+    #[test]
+    fn spawn_failure_does_not_expose_environment() {
+        let raw = "Operation not permitted envs: TOKEN=synthetic-secret";
+        let message = launch_error("", raw);
+        assert!(message.contains("dangerouslyDisableSandbox"));
+        assert!(!message.contains("synthetic-secret"));
+        assert!(!launch_error("synthetic-secret", "unknown").contains("synthetic-secret"));
+    }
+}
