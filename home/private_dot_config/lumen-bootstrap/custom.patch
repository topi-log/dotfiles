index ad082b0..773f3ca 100644
--- a/src/command/diff/diff_algo.rs
+++ b/src/command/diff/diff_algo.rs
@@ -219,3 +219,73 @@ pub fn find_hunk_starts(lines: &[DiffLine]) -> Vec<usize> {
     }
     hunks
 }
+
+/// Expand each changed block into old rows followed by new rows, retaining source line numbers.
+pub fn unified_rows(rows: Vec<DiffLine>) -> Vec<DiffLine> {
+    let mut result = Vec::new();
+    let mut i = 0;
+    while i < rows.len() {
+        if matches!(rows[i].change_type, ChangeType::Equal) {
+            result.push(rows[i].clone());
+            i += 1;
+            continue;
+        }
+        let start = i;
+        while i < rows.len() && !matches!(rows[i].change_type, ChangeType::Equal) {
+            i += 1;
+        }
+        for row in &rows[start..i] {
+            if row.old_line.is_some() {
+                let mut old = row.clone();
+                old.new_line = None;
+                old.new_segments = None;
+                old.change_type = ChangeType::Delete;
+                result.push(old);
+            }
+        }
+        for row in &rows[start..i] {
+            if row.new_line.is_some() {
+                let mut new = row.clone();
+                new.old_line = None;
+                new.old_segments = None;
+                new.change_type = ChangeType::Insert;
+                result.push(new);
+            }
+        }
+    }
+    result
+}
+
+#[cfg(test)]
+mod unified_tests {
+    use super::*;
+    #[test]
+    fn replacements_keep_both_sources_in_block_order() {
+        let rows = unified_rows(compute_side_by_side(
+            "same\nold a\nold b\ntail\n",
+            "same\nnew a\nnew b\nnew c\ntail\n",
+            4,
+        ));
+        let visible: Vec<_> = rows
+            .iter()
+            .map(|r| {
+                r.new_line
+                    .as_ref()
+                    .or(r.old_line.as_ref())
+                    .unwrap()
+                    .1
+                    .as_str()
+            })
+            .collect();
+        assert_eq!(
+            visible,
+            ["same", "old a", "old b", "new a", "new b", "new c", "tail"]
+        );
+        assert_eq!(rows[1].old_line.as_ref().unwrap().0, 2);
+        assert!(rows[1].new_line.is_none());
+        assert_eq!(rows[3].new_line.as_ref().unwrap().0, 2);
+        assert!(rows[3].old_line.is_none());
+        assert_eq!(rows[6].old_line.as_ref().unwrap().0, 4);
+        assert_eq!(rows[6].new_line.as_ref().unwrap().0, 5);
+    }
+}
