diff --git a/src/command/diff/review_help.rs b/src/command/diff/review_help.rs
new file mode 100644
index 0000000..1f94af9
--- /dev/null
+++ b/src/command/diff/review_help.rs
@@ -0,0 +1,275 @@
+//! Persistent, individually selectable review shortcuts.
+use ratatui::{
+    prelude::*,
+    widgets::{Block, Paragraph, Wrap},
+};
+use std::{
+    collections::BTreeSet,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        LazyLock, Mutex,
+    },
+};
+
+fn path(name: &str) -> Option<std::path::PathBuf> {
+    dirs::home_dir().map(|p| p.join(".config/lumen").join(name))
+}
+static VISIBLE: LazyLock<AtomicBool> = LazyLock::new(|| {
+    AtomicBool::new(
+        path("review-guide")
+            .and_then(|p| std::fs::read_to_string(p).ok())
+            .as_deref()
+            != Some("hidden"),
+    )
+});
+pub fn visible() -> bool {
+    VISIBLE.load(Ordering::Relaxed)
+}
+fn save(name: &str, text: &str) -> std::io::Result<()> {
+    if let Some(p) = path(name) {
+        std::fs::create_dir_all(p.parent().unwrap())?;
+        std::fs::write(p, text)?;
+    }
+    Ok(())
+}
+pub fn toggle() -> std::io::Result<()> {
+    let next = !visible();
+    save("review-guide", if next { "visible" } else { "hidden" })?;
+    VISIBLE.store(next, Ordering::Relaxed);
+    Ok(())
+}
+pub struct Shortcut {
+    pub id: &'static str,
+    pub label: &'static str,
+    default: bool,
+}
+pub const SHORTCUTS: &[Shortcut] = &[
+    Shortcut {
+        id: "focus",
+        label: "1:一覧 2:差分",
+        default: true,
+    },
+    Shortcut {
+        id: "sidebar",
+        label: "Cmd+B:一覧の表示/非表示",
+        default: true,
+    },
+    Shortcut {
+        id: "layout",
+        label: "Tab:一列/二列",
+        default: true,
+    },
+    Shortcut {
+        id: "files",
+        label: "Ctrl+P:ファイル検索",
+        default: true,
+    },
+    Shortcut {
+        id: "next_file",
+        label: "Ctrl+J/K:次/前のファイル",
+        default: false,
+    },
+    Shortcut {
+        id: "move",
+        label: "↑↓/j/k:移動",
+        default: false,
+    },
+    Shortcut {
+        id: "hunk",
+        label: "{/}:変更箇所",
+        default: false,
+    },
+    Shortcut {
+        id: "line",
+        label: "v:行選択",
+        default: true,
+    },
+    Shortcut {
+        id: "range",
+        label: "Shift+↑↓:範囲選択",
+        default: true,
+    },
+    Shortcut {
+        id: "side",
+        label: "行選択中←→:変更前/後",
+        default: false,
+    },
+    Shortcut {
+        id: "comment",
+        label: "c:コメント",
+        default: true,
+    },
+    Shortcut {
+        id: "comments",
+        label: "Shift+C:コメント一覧",
+        default: true,
+    },
+    Shortcut {
+        id: "github",
+        label: "F2:GitHubレビュー",
+        default: true,
+    },
+    Shortcut {
+        id: "save",
+        label: "Enter:コメント保存",
+        default: true,
+    },
+    Shortcut {
+        id: "newline",
+        label: "Ctrl+J:コメント改行",
+        default: true,
+    },
+    Shortcut {
+        id: "send",
+        label: "s:送信",
+        default: true,
+    },
+    Shortcut {
+        id: "quit",
+        label: "q:終了",
+        default: true,
+    },
+    Shortcut {
+        id: "search",
+        label: "/:検索",
+        default: false,
+    },
+    Shortcut {
+        id: "help",
+        label: "?:ヘルプ",
+        default: true,
+    },
+];
+fn defaults() -> BTreeSet<String> {
+    SHORTCUTS
+        .iter()
+        .filter(|s| s.default)
+        .map(|s| s.id.to_string())
+        .collect()
+}
+static PINNED: LazyLock<Mutex<BTreeSet<String>>> = LazyLock::new(|| {
+    Mutex::new(
+        path("review-shortcuts.json")
+            .and_then(|p| std::fs::read_to_string(p).ok())
+            .and_then(|s| serde_json::from_str(&s).ok())
+            .unwrap_or_else(defaults),
+    )
+});
+pub fn toggle_item(index: usize) -> std::io::Result<()> {
+    let Some(item) = SHORTCUTS.get(index) else {
+        return Ok(());
+    };
+    let mut pinned = PINNED.lock().unwrap();
+    let mut next = pinned.clone();
+    if !next.remove(item.id) {
+        next.insert(item.id.to_owned());
+    }
+    save("review-shortcuts.json", &serde_json::to_string(&next)?)?;
+    *pinned = next;
+    Ok(())
+}
+fn lines(width: u16, pinned: &BTreeSet<String>) -> Vec<String> {
+    let mut result = Vec::new();
+    let mut row = String::new();
+    for item in SHORTCUTS.iter().filter(|s| pinned.contains(s.id)) {
+        if !row.is_empty() && Line::from(format!("{row}  {}", item.label)).width() > width as usize
+        {
+            result.push(std::mem::take(&mut row));
+        }
+        if !row.is_empty() {
+            row.push_str("  ");
+        }
+        row.push_str(item.label);
+    }
+    if !row.is_empty() {
+        result.push(row);
+    }
+    result
+}
+pub fn height(width: u16, height: u16) -> u16 {
+    if !visible() {
+        return 1;
+    }
+    let rows: usize = lines(width, &PINNED.lock().unwrap())
+        .iter()
+        .map(|s| {
+            Line::from(s.as_str())
+                .width()
+                .max(1)
+                .div_ceil(width.max(1) as usize)
+        })
+        .sum();
+    (rows.saturating_add(1).min(u16::MAX as usize) as u16)
+        .min(height.saturating_sub(2))
+        .max(1)
+}
+pub fn draw(frame: &mut Frame, area: Rect) {
+    if !visible() {
+        return;
+    }
+    let t = super::theme::get();
+    frame.render_widget(
+        Paragraph::new(lines(area.width, &PINNED.lock().unwrap()).join("\n"))
+            .wrap(Wrap { trim: false })
+            .style(Style::default().fg(t.ui.text_primary).bg(t.ui.bg)),
+        area,
+    );
+}
+pub fn draw_picker(frame: &mut Frame, area: Rect, selected: usize, error: &str) {
+    let t = super::theme::get();
+    let block = Block::bordered().title("常時表示するキー · ↑↓:選択 Space:ON/OFF Esc:戻る");
+    let inner = block.inner(area);
+    frame.render_widget(block, area);
+    let pinned = PINNED.lock().unwrap();
+    let start = selected.saturating_sub(inner.height.saturating_sub(2) as usize);
+    let mut rows: Vec<Line> = SHORTCUTS
+        .iter()
+        .enumerate()
+        .skip(start)
+        .map(|(i, s)| {
+            Line::from(format!(
+                "{} [{}] {}",
+                if i == selected { ">" } else { " " },
+                if pinned.contains(s.id) { "x" } else { " " },
+                s.label
+            ))
+            .style(if i == selected {
+                Style::default().fg(t.ui.selection_fg).bg(t.ui.selection_bg)
+            } else {
+                Style::default().fg(t.ui.text_primary).bg(t.ui.bg)
+            })
+        })
+        .collect();
+    if !error.is_empty() {
+        rows.insert(0, Line::from(error.to_owned()));
+    }
+    frame.render_widget(Paragraph::new(rows), inner);
+}
+pub fn toggle_layout(
+    current: super::types::DiffFullscreen,
+    _deleted: bool,
+) -> super::types::DiffFullscreen {
+    use super::types::DiffFullscreen;
+    match current {
+        DiffFullscreen::None => DiffFullscreen::Unified,
+        _ => DiffFullscreen::None,
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn selected_items_only_and_empty_selection() {
+        let pins = BTreeSet::from(["comment".to_string(), "line".to_string()]);
+        assert_eq!(lines(160, &pins), vec!["v:行選択  c:コメント"]);
+        assert!(lines(80, &BTreeSet::new()).is_empty());
+        assert!(lines(40, &defaults()).len() > lines(160, &defaults()).len());
+    }
+    #[test]
+    fn layout_cycles() {
+        use super::super::types::DiffFullscreen::*;
+        assert_eq!(toggle_layout(None, false), Unified);
+        assert_eq!(toggle_layout(NewOnly, false), None);
+        assert_eq!(toggle_layout(None, true), Unified);
+    }
+}
