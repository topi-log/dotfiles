+#!/usr/bin/env python3
+"""Unix PTY smoke test; run with a built lumen path. No live terminal/GitHub use."""
+import atexit
+import fcntl
+import json
+import os
+from pathlib import Path
+import pty
+import select
+import signal
+import struct
+import subprocess
+import sys
+import tempfile
+import termios
+import time
+
+binary = str(Path(sys.argv[1] if len(sys.argv) > 1 else 'target/debug/lumen').resolve())
+root = Path(tempfile.mkdtemp(prefix='lumen-keyboard-test-'))
+active_children = set()
+def cleanup_children():
+    for pid in active_children:
+        try:
+            if os.waitpid(pid, os.WNOHANG)[0] == 0:
+                os.kill(pid, signal.SIGTERM)
+                os.waitpid(pid, 0)
+        except ChildProcessError:
+            pass
+atexit.register(cleanup_children)
+repo = root / 'repo'
+repo.mkdir()
+home = root / 'home'
+home.mkdir()
+
+def git(*args):
+    subprocess.run(['git', '-C', str(repo), *args], check=True, capture_output=True)
+
+git('init')
+source = repo / 'sample.txt'
+source.write_text(''.join(f'line {i}\n' for i in range(1, 31)))
+git('add', '.')
+git('-c', 'user.name=Test', '-c', 'user.email=test@example.invalid', 'commit', '-m', 'fixture')
+source.write_text(source.read_text().replace('line 10\n', 'changed 10\n'))
+
+class Session:
+    def __init__(self, name):
+        self.output = root / (name + '.md')
+        self.buf = b''
+        self.pid, self.fd = pty.fork()
+        if self.pid == 0:
+            os.chdir(repo)
+            os.environ.update(HOME=str(home), TERM='xterm-256color')
+            os.execv(binary, [binary, 'diff', '--output', str(self.output)])
+        active_children.add(self.pid)
+        fcntl.ioctl(self.fd, termios.TIOCSWINSZ, struct.pack('HHHH', 45, 160, 0, 0))
+        self.drain(5)
+    def drain(self, seconds=0.4):
+        end = time.monotonic() + seconds
+        while time.monotonic() < end:
+            if select.select([self.fd], [], [], .05)[0]:
+                try:
+                    data = os.read(self.fd, 65536)
+                except OSError:
+                    return
+                self.buf += data
+                if b'\x1b[6n' in data:
+                    os.write(self.fd, b'\x1b[1;1R')
+    def send(self, text):
+        os.write(self.fd, text.encode())
+        self.drain()
+    def finish(self):
+        self.drain(1)
+        for _ in range(20):
+            pid, status = os.waitpid(self.pid, os.WNOHANG)
+            if pid:
+                active_children.discard(self.pid)
+                self.output.with_suffix('.screen').write_bytes(self.buf)
+                os.close(self.fd)
+                assert os.waitstatus_to_exitcode(status) == 0
+                return
+            self.drain(.1)
+        os.kill(self.pid, signal.SIGTERM)
+        os.waitpid(self.pid, 0)
+        active_children.discard(self.pid)
+        os.close(self.fd)
+        raise AssertionError('TUI did not exit')
+
+s = Session('ranges')
+s.send('?'); s.send('p'); s.send(' '); s.send('\x1b[B'); s.send(' ')
+pins = json.loads((home / '.config/lumen/review-shortcuts.json').read_text())
+assert 'focus' not in pins and 'sidebar' not in pins and 'comment' in pins
