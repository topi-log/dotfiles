#!/usr/bin/env python3
"""Open the local Claude Review VS Code extension for a WezTerm pane."""

import argparse
import subprocess
import urllib.parse


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", required=True)
    parser.add_argument("--claude-pane", required=True)
    args = parser.parse_args()
    query = urllib.parse.urlencode({"root": args.root, "pane": args.claude_pane})
    uri = "vscode://topilog.claude-review/open?" + query
    return subprocess.run(["/usr/bin/open", uri]).returncode


if __name__ == "__main__":
    raise SystemExit(main())
