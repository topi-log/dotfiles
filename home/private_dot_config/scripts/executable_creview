#!/usr/bin/env python3
"""Read-only terminal UI for reviewing local Git changes with Claude Code."""

import argparse
import curses
import difflib
import json
import os
import shutil
import subprocess
import sys
import unicodedata
from dataclasses import dataclass
from typing import List, Optional, Tuple


@dataclass
class ChangedFile:
    status: str
    path: str
    old_path: Optional[str] = None


@dataclass
class DiffRow:
    old_no: Optional[int]
    old_text: str
    new_no: Optional[int]
    new_text: str
    kind: str  # equal, add, delete, change


@dataclass
class Comment:
    path: str
    side: str
    line: int
    text: str


def git(root: str, *args: str, check: bool = True) -> bytes:
    result = subprocess.run(
        ["git", "-C", root, *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if check and result.returncode != 0:
        raise RuntimeError(result.stderr.decode("utf-8", "replace").strip())
    return result.stdout


def changed_files(root: str) -> List[ChangedFile]:
    raw = git(root, "status", "--porcelain=v1", "-z", "--untracked-files=all")
    fields = raw.decode("utf-8", "surrogateescape").split("\0")
    result: List[ChangedFile] = []
    i = 0
    while i < len(fields) and fields[i]:
        entry = fields[i]
        status = entry[:2]
        path = entry[3:]
        old_path = None
        if "R" in status or "C" in status:
            i += 1
            if i < len(fields):
                old_path = fields[i]
        result.append(ChangedFile(status=status, path=path, old_path=old_path))
        i += 1
    return result


def decode_file(data: bytes) -> Tuple[List[str], bool]:
    if b"\0" in data:
        return ["(binary file)"], True
    return data.decode("utf-8", "replace").splitlines(), False


def file_versions(root: str, item: ChangedFile) -> Tuple[List[str], List[str], bool]:
    head_path = item.old_path or item.path
    old_raw = git(root, "show", "HEAD:" + head_path, check=False)
    target = os.path.join(root, item.path)
    try:
        with open(target, "rb") as handle:
            new_raw = handle.read()
    except (FileNotFoundError, IsADirectoryError):
        new_raw = b""
    old_lines, old_binary = decode_file(old_raw)
    new_lines, new_binary = decode_file(new_raw)
    return old_lines, new_lines, old_binary or new_binary


def side_by_side(old: List[str], new: List[str]) -> List[DiffRow]:
    rows: List[DiffRow] = []
    matcher = difflib.SequenceMatcher(None, old, new, autojunk=False)
    for tag, a1, a2, b1, b2 in matcher.get_opcodes():
        if tag == "equal":
            for offset in range(a2 - a1):
                rows.append(DiffRow(a1 + offset + 1, old[a1 + offset], b1 + offset + 1, new[b1 + offset], "equal"))
        elif tag == "delete":
            for index in range(a1, a2):
                rows.append(DiffRow(index + 1, old[index], None, "", "delete"))
        elif tag == "insert":
            for index in range(b1, b2):
                rows.append(DiffRow(None, "", index + 1, new[index], "add"))
        else:
            count = max(a2 - a1, b2 - b1)
            for offset in range(count):
                oi = a1 + offset
                ni = b1 + offset
                rows.append(DiffRow(
                    oi + 1 if oi < a2 else None,
                    old[oi] if oi < a2 else "",
                    ni + 1 if ni < b2 else None,
                    new[ni] if ni < b2 else "",
                    "change",
                ))
    return rows


def display_width(text: str) -> int:
    return sum(
        0 if unicodedata.combining(char) else 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
        for char in text
    )


def clip(text: str, width: int) -> str:
    if width <= 0:
        return ""
    text = text.replace("\t", "    ")
    result = []
    used = 0
    for char in text:
        char_width = 0 if unicodedata.combining(char) else 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
        if used + char_width > width:
            break
        result.append(char)
        used += char_width
    return "".join(result)


def slice_cells(text: str, start: int, width: int) -> str:
    """Return a display-cell slice without splitting wide characters."""
    text = text.replace("\t", "    ")
    result = []
    position = 0
    used = 0
    for char in text:
        char_width = 0 if unicodedata.combining(char) else 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
        next_position = position + char_width
        if next_position <= start:
            position = next_position
            continue
        if used + char_width > width:
            break
        result.append(char)
        used += char_width
        position = next_position
    return "".join(result)


def wrap_cells(text: str, width: int) -> List[str]:
    """Wrap text by terminal display cells without splitting wide characters."""
    if width <= 0:
        return [""]
    lines = []
    remaining = text
    while remaining:
        part = clip(remaining, width)
        if not part:
            break
        lines.append(part)
        remaining = remaining[len(part):]
    return lines or [""]


def wrap_comment(text: str, width: int) -> List[str]:
    lines = []
    for logical_line in text.split("\n"):
        lines.extend(wrap_cells(logical_line, width))
    return lines or [""]


def textmate_highlight(pathname: str, contents: List[List[str]]):
    node = next(
        (
            candidate
            for candidate in (
                shutil.which("node"),
                "/opt/homebrew/bin/node",
                "/usr/local/bin/node",
            )
            if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK)
        ),
        None,
    )
    helper = os.path.expanduser("~/.config/creview/highlight.js")
    if not node or not os.path.isfile(helper):
        return [[[[line, "#D4D4D4"]] for line in lines] for lines in contents]
    request = {"path": pathname, "contents": ["\n".join(lines) for lines in contents]}
    result = subprocess.run(
        [node, helper],
        input=json.dumps(request),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        return [[[[line, "#D4D4D4"]] for line in lines] for lines in contents]
    try:
        return json.loads(result.stdout)["contents"]
    except (json.JSONDecodeError, KeyError, TypeError):
        return [[[[line, "#D4D4D4"]] for line in lines] for lines in contents]


class ReviewUI:
    def __init__(self, screen, root: str, pane_id: Optional[str]):
        self.screen = screen
        self.root = root
        self.pane_id = pane_id
        self.files = changed_files(root)
        self.file_index = 0
        self.file_scroll = 0
        self.rows: List[DiffRow] = []
        self.row_index = 0
        self.row_scroll = 0
        self.horizontal_scroll = 0
        self.focus = "files"
        self.comment_side = "after"
        self.comments: List[Comment] = []
        self.old_highlights = []
        self.new_highlights = []
        self.theme_colors = {}
        self.theme_pairs = {}
        self.next_theme_color = 32
        self.next_theme_pair = 32
        self.message = ""
        self.load_diff()

    def load_diff(self):
        self.horizontal_scroll = 0
        if not self.files:
            self.rows = []
            self.row_index = 0
            self.row_scroll = 0
            return
        old, new, _ = file_versions(self.root, self.files[self.file_index])
        self.rows = side_by_side(old, new)
        self.row_index = next((index for index, row in enumerate(self.rows) if row.kind != "equal"), 0)
        self.row_scroll = max(0, self.row_index - 3)
        self.old_highlights, self.new_highlights = textmate_highlight(self.files[self.file_index].path, [old, new])
        self.select_side(self.comment_side)

    def add(self, y: int, x: int, text: str, attr=0):
        height, width = self.screen.getmaxyx()
        if 0 <= y < height and 0 <= x < width:
            try:
                self.screen.addstr(y, x, clip(text, width - x - 1), attr)
            except curses.error:
                pass

    def color(self, pair: int, selected: bool = False):
        attr = curses.color_pair(pair)
        if selected:
            attr |= curses.A_REVERSE
        return attr

    def theme_color(self, color: str) -> Optional[int]:
        color = color.upper()
        if color in self.theme_colors:
            return self.theme_colors[color]
        if not (curses.COLORS >= 256 and curses.can_change_color() and color.startswith("#") and len(color) == 7):
            return None
        if self.next_theme_color >= curses.COLORS:
            return None
        slot = self.next_theme_color
        self.next_theme_color += 1
        red, green, blue = (int(color[index:index + 2], 16) for index in (1, 3, 5))
        curses.init_color(slot, round(red * 1000 / 255), round(green * 1000 / 255), round(blue * 1000 / 255))
        self.theme_colors[color] = slot
        return slot

    def theme_pair(self, foreground: str, background: Optional[str] = None) -> int:
        key = (foreground.upper(), background.upper() if background else None)
        if key in self.theme_pairs:
            return self.theme_pairs[key]
        foreground_slot = self.theme_color(foreground)
        background_slot = self.theme_color(background) if background else -1
        if foreground_slot is None or (background and background_slot is None):
            return 12
        if self.next_theme_pair >= curses.COLOR_PAIRS:
            return 12
        pair = self.next_theme_pair
        self.next_theme_pair += 1
        curses.init_pair(pair, foreground_slot, background_slot)
        self.theme_pairs[key] = pair
        return pair

    def comments_for_row(self, row: DiffRow) -> List[Comment]:
        if not self.files:
            return []
        path = self.files[self.file_index].path
        return [
            comment for comment in self.comments
            if comment.path == path and (
                (comment.side == "before" and comment.line == row.old_no)
                or (comment.side == "after" and comment.line == row.new_no)
            )
        ]

    def row_height(self, row: DiffRow, width: int) -> int:
        comment_width = max(1, width - 4)
        return 1 + sum(len(wrap_comment(comment.text, comment_width)) for comment in self.comments_for_row(row))

    def ensure_row_visible(self, body_height: int, diff_width: int):
        if not self.rows:
            return
        if self.row_index < self.row_scroll:
            self.row_scroll = self.row_index
        while self.row_scroll < self.row_index:
            used = sum(self.row_height(row, diff_width) for row in self.rows[self.row_scroll:self.row_index + 1])
            if used <= body_height:
                break
            self.row_scroll += 1

    def change_indices(self) -> List[int]:
        return [
            index for index, row in enumerate(self.rows)
            if row.kind != "equal" and (index == 0 or self.rows[index - 1].kind == "equal")
        ]

    def jump_change(self, direction: int):
        changes = self.change_indices()
        if not changes:
            self.message = "No changed lines"
            return
        if direction > 0:
            self.row_index = next((index for index in changes if index > self.row_index), changes[0])
        else:
            self.row_index = next((index for index in reversed(changes) if index < self.row_index), changes[-1])
        self.select_side(self.comment_side)

    def select_side(self, preferred: str):
        if not self.rows:
            return
        row = self.rows[self.row_index]
        if preferred == "before" and row.old_no is not None:
            self.comment_side = "before"
        elif preferred == "after" and row.new_no is not None:
            self.comment_side = "after"
        elif row.new_no is not None:
            self.comment_side = "after"
        elif row.old_no is not None:
            self.comment_side = "before"

    def draw_code(self, y: int, x: int, segments, start: int, width: int, selected: bool, background: Optional[str]):
        position = 0
        drawn = 0
        for value, color in segments:
            value = value.rstrip("\n").replace("\t", "    ")
            visible = slice_cells(value, max(0, start - position), max(0, width - drawn))
            if visible and position + display_width(value) > start:
                attr = curses.color_pair(self.theme_pair(color, background))
                if selected:
                    attr |= curses.A_BOLD
                self.add(y, x + drawn, visible, attr)
                drawn += display_width(visible)
            position += display_width(value)
            if drawn >= width:
                break

    def draw(self):
        self.screen.erase()
        height, width = self.screen.getmaxyx()
        if height < 8 or width < 70:
            self.add(0, 0, "Terminal is too small (minimum 70x8)", curses.A_BOLD)
            self.screen.refresh()
            return

        list_width = max(24, min(40, width // 4))
        diff_width = width - list_width - 1
        half = diff_width // 2
        body_top = 2
        body_bottom = height - 2
        body_height = body_bottom - body_top

        title = " Claude Review — READ ONLY · DARK+ "
        self.add(0, 0, title, curses.A_BOLD | curses.color_pair(4))
        self.add(0, display_width(title), os.path.basename(self.root), curses.A_DIM)
        self.add(1, 0, "Changed files", curses.A_BOLD if self.focus == "files" else curses.A_DIM)
        offset = f"  horizontal: {self.horizontal_scroll}" if self.horizontal_scroll else ""
        changes = self.change_indices()
        current_change = sum(1 for index in changes if index <= self.row_index) if changes else 0
        change_status = f"  hunk: {current_change}/{len(changes)}"
        before_label = "▸ BEFORE" if self.focus == "diff" and self.comment_side == "before" else "BEFORE"
        after_label = "▸ AFTER" if self.focus == "diff" and self.comment_side == "after" else "AFTER"
        self.add(1, list_width + 1, before_label + offset + change_status, curses.A_BOLD | curses.color_pair(2))
        self.add(1, list_width + 1 + half, after_label + offset, curses.A_BOLD | curses.color_pair(1))

        for y in range(1, body_bottom):
            self.add(y, list_width, "│", curses.A_DIM)
        for y in range(1, body_bottom):
            self.add(y, list_width + half, "│", curses.A_DIM)

        if self.file_index < self.file_scroll:
            self.file_scroll = self.file_index
        if self.file_index >= self.file_scroll + body_height:
            self.file_scroll = self.file_index - body_height + 1
        for offset, item in enumerate(self.files[self.file_scroll:self.file_scroll + body_height]):
            index = self.file_scroll + offset
            marker = "A" if item.status == "??" or "A" in item.status else "D" if "D" in item.status else "M"
            pair = 1 if marker == "A" else 2 if marker == "D" else 3
            label = f" {marker} {item.path}"
            selected = self.focus == "files" and index == self.file_index
            self.add(body_top + offset, 0, clip(label, list_width), self.color(pair, selected))

        self.ensure_row_visible(body_height, diff_width)
        comment_keys = {(c.path, c.side, c.line) for c in self.comments}
        current_path = self.files[self.file_index].path if self.files else ""
        content_width = half - 7
        y = body_top
        for index, row in enumerate(self.rows[self.row_scroll:], self.row_scroll):
            if y >= body_bottom:
                break
            selected = self.focus == "diff" and index == self.row_index
            old_mark = "●" if row.old_no and (current_path, "before", row.old_no) in comment_keys else "-" if row.kind in ("delete", "change") else " "
            new_mark = "●" if row.new_no and (current_path, "after", row.new_no) in comment_keys else "+" if row.kind in ("add", "change") else " "
            old_prefix = f"{old_mark}{row.old_no or '':>4} "
            new_prefix = f"{new_mark}{row.new_no or '':>4} "
            old_background = "#3A2426" if row.kind in ("delete", "change") else None
            new_background = "#20382B" if row.kind in ("add", "change") else None
            old_foreground = "#D16969" if old_background else "#D4D4D4"
            new_foreground = "#6A9955" if new_background else "#D4D4D4"
            old_attr = curses.color_pair(self.theme_pair(old_foreground, old_background))
            new_attr = curses.color_pair(self.theme_pair(new_foreground, new_background))
            if selected:
                old_attr |= curses.A_BOLD
                new_attr |= curses.A_BOLD
            if old_background:
                self.add(y, list_width + 1, " " * (half - 1), old_attr)
            if new_background:
                self.add(y, list_width + half + 1, " " * (half - 1), new_attr)
            self.add(y, list_width + 1, old_prefix, old_attr)
            self.add(y, list_width + half + 1, new_prefix, new_attr)
            old_segments = self.old_highlights[row.old_no - 1] if row.old_no and row.old_no <= len(self.old_highlights) else []
            new_segments = self.new_highlights[row.new_no - 1] if row.new_no and row.new_no <= len(self.new_highlights) else []
            self.draw_code(y, list_width + 1 + 6, old_segments, self.horizontal_scroll, content_width, selected, old_background)
            self.draw_code(y, list_width + half + 1 + 6, new_segments, self.horizontal_scroll, content_width, selected, new_background)
            y += 1
            for comment in self.comments_for_row(row):
                side = "変更後" if comment.side == "after" else "変更前"
                prefix = f"  💬 {side}: "
                wrapped = wrap_comment(comment.text, max(1, diff_width - display_width(prefix) - 2))
                for part_index, part in enumerate(wrapped):
                    if y >= body_bottom:
                        break
                    label = prefix if part_index == 0 else " " * display_width(prefix)
                    self.add(y, list_width + 1, label + part, curses.A_BOLD | curses.color_pair(3))
                    y += 1

        help_text = "j/k: move  [/] side  n/N: hunk  c: comment  ?: help  S: send"
        selected_comment = self.comment_at_cursor()
        if selected_comment and not self.message:
            help_text = "Comment: " + selected_comment.text
        if self.message:
            help_text = self.message
        self.add(height - 1, 0, clip(help_text, width - 1), curses.A_REVERSE)
        self.add(height - 1, max(0, width - 16), f"{len(self.comments)} comments ", curses.A_REVERSE | curses.A_BOLD)
        self.screen.refresh()

    def comment_location(self) -> Optional[Tuple[str, str, int]]:
        if not self.files or not self.rows:
            return None
        row = self.rows[self.row_index]
        self.select_side(self.comment_side)
        side = self.comment_side
        line = row.old_no if side == "before" else row.new_no
        if line is None:
            return None
        return self.files[self.file_index].path, side, line

    def comment_at_cursor(self) -> Optional[Comment]:
        location = self.comment_location()
        if location is None:
            return None
        return next((comment for comment in self.comments if (comment.path, comment.side, comment.line) == location), None)

    def input_comment(self, title: str, initial: str = "") -> Optional[str]:
        curses.curs_set(1)
        value = initial
        try:
            while True:
                height, width = self.screen.getmaxyx()
                self.screen.erase()
                self.add(0, 0, f" レビューコメント — {title} ", curses.A_BOLD | curses.color_pair(4))
                self.add(1, 0, "─" * max(0, width - 1), curses.A_DIM)

                body_width = max(1, width - 4)
                body_height = max(1, height - 4)
                rendered = wrap_comment(value, body_width)
                scroll = max(0, len(rendered) - body_height)
                for offset, line in enumerate(rendered[scroll:scroll + body_height]):
                    self.add(2 + offset, 2, line)

                cursor_line = min(height - 2, 2 + len(rendered) - 1 - scroll)
                cursor_x = min(width - 2, 2 + display_width(rendered[-1]))
                self.add(height - 1, 0, "Shift+Enter: 改行  Enter: 保存  Esc: キャンセル", curses.A_REVERSE)
                self.screen.move(cursor_line, cursor_x)
                self.screen.refresh()
                key = self.screen.get_wch()
                if key == "\x1b":
                    return None
                if key in ("\r", curses.KEY_ENTER):
                    return value.strip()
                if key == "\n":  # WezTerm maps Shift+Enter to LF; Enter remains CR.
                    value += "\n"
                if key in (curses.KEY_BACKSPACE, "\b", "\x7f"):
                    value = value[:-1]
                elif isinstance(key, str) and key.isprintable():
                    value += key
        finally:
            curses.curs_set(0)

    def prompt_comment(self):
        location = self.comment_location()
        if location is None:
            return
        path, side, line = location
        existing = self.comment_at_cursor()
        label = "BEFORE" if side == "before" else "AFTER"
        title = f"{label} {path}:{line}"
        text = self.input_comment(title, existing.text if existing else "")
        if text is None:
            self.message = "Comment cancelled"
            return
        if text:
            if existing:
                existing.text = text
            else:
                self.comments.append(Comment(path, side, line, text))
            self.message = "Comment added"

    def delete_comment(self):
        comment = self.comment_at_cursor()
        if not comment:
            self.message = "No comment on this line"
            return
        self.comments.remove(comment)
        self.message = "Comment removed"

    def show_page(self, title: str, lines: List[str]):
        self.screen.erase()
        height, width = self.screen.getmaxyx()
        self.add(0, 0, f" {title} ", curses.A_BOLD | curses.color_pair(4))
        for index, line in enumerate(lines[:height - 3]):
            self.add(index + 2, 2, clip(line, width - 4))
        self.add(height - 1, 0, "Escで戻る", curses.A_REVERSE)
        self.screen.refresh()
        while self.screen.getch() != 27:
            pass

    def show_help(self):
        self.show_page("操作ヘルプ", [
            "j / k または ↑ / ↓   ファイル・diff行を移動",
            "Tab / Enter           左右diffへフォーカスを移動",
            "Esc                   キャンセル／戻る／終了",
            "[ / ]                 コメント対象を変更前／変更後へ切替",
            "h / l または ← / →   長い行を横スクロール",
            "n / N                 次／前の変更ブロックへジャンプ",
            "c                     選択側の行にコメントを追加・上書き",
            "  入力中: Shift+Enter コメント内で改行（Enterは確定）",
            "x                     選択行のコメントを削除",
            "v                     追加済みコメントを一覧表示",
            "S                     コメントをClaude Codeへ下書き転送",
            "",
            "この画面は読み取り専用です。ファイルやGitの状態は変更しません。",
        ])

    def show_comments(self):
        lines = []
        for index, comment in enumerate(self.comments, 1):
            label = "after" if comment.side == "after" else "before"
            lines.append(f"{index}. {comment.path}:{comment.line} ({label})")
            lines.extend(f"   {line}" for line in comment.text.split("\n"))
        if not lines:
            lines = ["No review comments yet."]
        self.show_page(f"Review comments ({len(self.comments)})", lines)

    def send_draft(self) -> bool:
        if not self.comments:
            self.message = "No review comments yet"
            return False
        if not self.pane_id:
            self.message = "No Claude Code pane was supplied"
            return False
        lines = ["以下のレビューコメントに対応してください。", ""]
        for comment in self.comments:
            label = "変更後" if comment.side == "after" else "変更前"
            text = comment.text.replace("\n", "\n  ")
            lines.append(f"- {comment.path}:{comment.line}（{label}）: {text}")
        message = "\n".join(lines)
        wezterm = "/Applications/WezTerm.app/Contents/MacOS/wezterm"
        result = subprocess.run([wezterm, "cli", "send-text", "--pane-id", self.pane_id, message])
        if result.returncode != 0:
            self.message = "Could not send the review draft"
            return False
        return True

    def run(self):
        curses.nonl()
        curses.curs_set(0)
        self.screen.keypad(True)
        while True:
            self.draw()
            key = self.screen.getch()
            self.message = ""
            if key == 9:
                self.focus = "diff" if self.focus == "files" else "files"
            elif key in (ord("j"), curses.KEY_DOWN):
                if self.focus == "files" and self.files:
                    self.file_index = min(len(self.files) - 1, self.file_index + 1)
                    self.load_diff()
                elif self.rows:
                    self.row_index = min(len(self.rows) - 1, self.row_index + 1)
                    self.select_side(self.comment_side)
            elif key in (ord("k"), curses.KEY_UP):
                if self.focus == "files" and self.files:
                    self.file_index = max(0, self.file_index - 1)
                    self.load_diff()
                elif self.rows:
                    self.row_index = max(0, self.row_index - 1)
                    self.select_side(self.comment_side)
            elif key in (ord("h"), curses.KEY_LEFT) and self.focus == "diff":
                self.horizontal_scroll = max(0, self.horizontal_scroll - 8)
            elif key in (ord("l"), curses.KEY_RIGHT) and self.focus == "diff":
                self.horizontal_scroll += 8
            elif key == ord("n") and self.focus == "diff":
                self.jump_change(1)
            elif key == ord("N") and self.focus == "diff":
                self.jump_change(-1)
            elif key == ord("[") and self.focus == "diff":
                self.select_side("before")
            elif key == ord("]") and self.focus == "diff":
                self.select_side("after")
            elif key in (10, 13) and self.focus == "files":
                self.focus = "diff"
            elif key == 27:
                if self.focus == "diff":
                    self.focus = "files"
                else:
                    return
            elif key in (ord("c"), ord("C")) and self.focus == "diff":
                self.prompt_comment()
            elif key == ord("x") and self.focus == "diff":
                self.delete_comment()
            elif key == ord("v"):
                self.show_comments()
            elif key == ord("?"):
                self.show_help()
            elif key == ord("S"):
                if self.send_draft():
                    return


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", required=True)
    parser.add_argument("--claude-pane")
    args = parser.parse_args()

    def wrapped(screen):
        curses.start_color()
        curses.use_default_colors()
        if curses.COLORS >= 256 and curses.can_change_color():
            # Define VS Code Dark+ RGB values directly in private palette slots.
            dark_plus = {
                16: (212, 212, 212), # text      #D4D4D4
                17: (106, 153, 85),  # comment   #6A9955
                18: (197, 134, 192), # keyword   #C586C0
                19: (206, 145, 120), # string    #CE9178
                20: (181, 206, 168), # number    #B5CEA8
                21: (220, 220, 170), # function  #DCDCAA
                22: (78, 201, 176),  # type      #4EC9B0
                23: (156, 220, 254), # builtin   #9CDCFE
                24: (106, 153, 85),  # added
                25: (209, 105, 105), # deleted
                26: (220, 220, 170), # modified
                27: (86, 156, 214),  # declaration #569CD6
            }
            for slot, (red, green, blue) in dark_plus.items():
                curses.init_color(slot, round(red * 1000 / 255), round(green * 1000 / 255), round(blue * 1000 / 255))
            colors = {
                1: 24,
                2: 25,
                3: 26,
                4: 22,
                5: 17,
                6: 18,
                7: 19,
                8: 20,
                9: 21,
                10: 22,
                11: 23,
                12: 16,
                13: 27,
            }
        else:
            colors = {
                1: curses.COLOR_GREEN,
                2: curses.COLOR_RED,
                3: curses.COLOR_YELLOW,
                4: curses.COLOR_CYAN,
                5: curses.COLOR_GREEN,
                6: curses.COLOR_MAGENTA,
                7: curses.COLOR_YELLOW,
                8: curses.COLOR_CYAN,
                9: curses.COLOR_YELLOW,
                10: curses.COLOR_CYAN,
                11: curses.COLOR_BLUE,
                12: -1,
                13: curses.COLOR_BLUE,
            }
        for pair, foreground in colors.items():
            curses.init_pair(pair, foreground, -1)
        ReviewUI(screen, args.root, args.claude_pane).run()

    try:
        curses.wrapper(wrapped)
    except RuntimeError as error:
        print(f"creview: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
