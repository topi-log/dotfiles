#!/bin/bash
# Open a temporary full-screen pane.

set -euo pipefail

if [ -z "${WEZTERM_PANE:-}" ]; then
  echo "Error: not running inside WezTerm" >&2
  exit 1
fi

if command -v wezterm >/dev/null 2>&1; then
  WEZTERM_BIN=$(command -v wezterm)
elif [ -x /Applications/WezTerm.app/Contents/MacOS/wezterm ]; then
  WEZTERM_BIN=/Applications/WezTerm.app/Contents/MacOS/wezterm
else
  echo "Error: wezterm CLI not found" >&2
  exit 1
fi

case "${1:-sh}" in
  sh)  set -- zsh ;;
  git) shift; set -- lazygit "$@" ;;
esac

pane_id=$("$WEZTERM_BIN" cli split-pane --bottom --cwd "$(pwd)" -- "$@")
"$WEZTERM_BIN" cli zoom-pane --zoom --pane-id "$pane_id"
