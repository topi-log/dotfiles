# ~/.zprofile — ログインシェルで一度だけ読まれる。
#
# 環境変数と PATH だけを置く。これらは export すれば子プロセスに継承されるため、
# シェルを開くたびに再設定する必要がない。
# エイリアス・プロンプト・補完は継承されないので ~/.zshrc に置く。

# --- Homebrew -------------------------------------------------------------
# Apple Silicon は /opt/homebrew、Intel は /usr/local に入る。
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$_brew" ]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew

# --- PATH -----------------------------------------------------------------
# 自前のスクリプト。~/.config/scripts は wlay（wezterm のオーバーレイペイン）用。
export PATH="$HOME/.local/bin:$HOME/.config/scripts:$PATH"

# 以下はマシンによって導入状況が違うので、存在するときだけ PATH に足す。

# PostgreSQL 16（Homebrew の keg-only formula なので手動で PATH に入れる）
[ -d /opt/homebrew/opt/postgresql@16/bin ] &&
  export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"

# VS Code の code コマンド
[ -d "/Applications/Visual Studio Code.app/Contents/Resources/app/bin" ] &&
  export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# Go
[ -d /usr/local/go/bin ] && export PATH="$PATH:/usr/local/go/bin"

# Flutter
[ -d "$HOME/flutter/bin" ] && export PATH="$PATH:$HOME/flutter/bin"
